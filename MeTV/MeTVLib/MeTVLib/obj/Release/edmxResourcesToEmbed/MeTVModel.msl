<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2008/09/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="MeTVdbModelStoreContainer" CdmEntityContainer="MeTVdbEntities">
    <EntitySetMapping Name="tEpisodes">
      <EntityTypeMapping TypeName="MeTVdbModel.tEpisode">
        <MappingFragment StoreEntitySet="tEpisode">
          <ScalarProperty Name="ID" ColumnName="ID" />
          <ScalarProperty Name="Name" ColumnName="Name" />
          <ScalarProperty Name="Show" ColumnName="Show" />
          <ScalarProperty Name="Season" ColumnName="Season" />
          <ScalarProperty Name="SeasonEpNum" ColumnName="SeasonEpNum" />
          <ScalarProperty Name="Description" ColumnName="Description" />
          <ScalarProperty Name="VideoFilePath" ColumnName="VideoFilePath" />
          <ScalarProperty Name="ImageFilePath" ColumnName="ImageFilePath" />
          <ScalarProperty Name="RecentPlays" ColumnName="RecentPlays" />
          <ScalarProperty Name="TotalPlays" ColumnName="TotalPlays" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="tGenres">
      <EntityTypeMapping TypeName="MeTVdbModel.tGenre">
        <MappingFragment StoreEntitySet="tGenre">
          <ScalarProperty Name="ID" ColumnName="ID" />
          <ScalarProperty Name="Name" ColumnName="Name" />
          <ScalarProperty Name="Description" ColumnName="Description" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="tShows">
      <EntityTypeMapping TypeName="MeTVdbModel.tShow">
        <MappingFragment StoreEntitySet="tShow">
          <ScalarProperty Name="ID" ColumnName="ID" />
          <ScalarProperty Name="Name" ColumnName="Name" />
          <ScalarProperty Name="Genre" ColumnName="Genre" />
          <ScalarProperty Name="Description" ColumnName="Description" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>